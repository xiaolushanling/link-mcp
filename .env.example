# API 网关根地址（包含 /api，不包含 /lmsservice 等服务路径）
LINK_API_BASE_URL=https://demo.linkl.com.cn/api
# 从对应环境获取；oauthLogin 不会返回此凭证。
LINK_TOKEN=
# 可选：对定义了 customerKey 的请求体自动补入；显式传入值优先。
LINK_CUSTOMER_KEY=
LINK_TIMEOUT_SECONDS=30
# 可选逗号分隔：user,lms,pds,finance,edge,basicdata；空值表示全部。
LINK_SERVICES=
# true 仅暴露查询类工具；默认包含文档中的全部接口。
LINK_READ_ONLY=false
LINK_MAX_RESPONSE_BYTES=20971520
LINK_MAX_RESPONSE_CHARACTERS=25000
